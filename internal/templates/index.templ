package templates

import (
	"fmt"
	"github.com/taslabs-net/loggarr/internal/models"
)

func containerCount(containers []models.Container) string {
	return fmt.Sprintf("%d", len(containers))
}

templ Index(containers []models.Container, bufferMax int, version string) {
	<!DOCTYPE html>
	<html lang="en" data-theme="dark">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<title>Loggarr</title>
			<link href="/static/vendor/daisyui.min.css" rel="stylesheet" type="text/css"/>
			<script src="/static/vendor/tailwind.js"></script>
			<script src="/static/vendor/htmx.min.js"></script>
			<script src="/static/vendor/htmx-sse.js"></script>
			<style>
				.log-container { font-family: 'Fira Code', 'Consolas', monospace; font-size: 0.8125rem; }
				.log-entry { border-left: 3px solid currentColor; }
				.log-entry:hover { background-color: rgba(255,255,255,0.05); }
				.level-alert { color: #f87171; border-left-color: #f87171; }
				.level-error { color: #ef4444; border-left-color: #ef4444; }
				.level-warning { color: #f59e0b; border-left-color: #f59e0b; }
				.level-info { color: #3b82f6; border-left-color: #3b82f6; }
				.level-debug { color: #6b7280; border-left-color: #6b7280; }
				.btn-level-alert { background-color: #f87171; border-color: #f87171; color: #000; }
				.btn-level-alert:hover { background-color: #ef4444; border-color: #ef4444; }
				.btn-level-error { background-color: #ef4444; border-color: #ef4444; color: #fff; }
				.btn-level-error:hover { background-color: #dc2626; border-color: #dc2626; }
				.btn-level-warning { background-color: #f59e0b; border-color: #f59e0b; color: #000; }
				.btn-level-warning:hover { background-color: #d97706; border-color: #d97706; }
				.btn-level-info { background-color: #3b82f6; border-color: #3b82f6; color: #fff; }
				.btn-level-info:hover { background-color: #2563eb; border-color: #2563eb; }
				.btn-level-debug { background-color: #6b7280; border-color: #6b7280; color: #fff; }
				.btn-level-debug:hover { background-color: #4b5563; border-color: #4b5563; }
				/* Hide scrollbar for level filters on mobile */
				.scrollbar-hide { -ms-overflow-style: none; scrollbar-width: none; }
				.scrollbar-hide::-webkit-scrollbar { display: none; }
			</style>
		</head>
		<body class="bg-base-300 min-h-screen" data-buffer-max={ fmt.Sprintf("%d", bufferMax) }>
			<div class="flex flex-col h-screen">
				<header class="navbar bg-base-200 border-b border-base-300">
					<div class="flex-1">
						<span class="text-xl font-bold">Loggarr</span>
					</div>
					<div class="flex-none gap-2">
						<label class="swap swap-rotate btn btn-ghost btn-circle btn-sm">
							<!-- this hidden checkbox controls the state -->
							<input type="checkbox" class="theme-controller" value="light" />
							<!-- sun icon -->
							<svg class="swap-on fill-current w-5 h-5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path d="M5.64,17l-.71.71a1,1,0,0,0,0,1.41,1,1,0,0,0,1.41,0l.71-.71A1,1,0,0,0,5.64,17ZM5,12a1,1,0,0,0-1-1H3a1,1,0,0,0,0,2H4A1,1,0,0,0,5,12Zm7-7a1,1,0,0,0,1-1V3a1,1,0,0,0-2,0V4A1,1,0,0,0,12,5ZM5.64,7.05a1,1,0,0,0,.7.29,1,1,0,0,0,.71-.29,1,1,0,0,0,0-1.41l-.71-.71A1,1,0,0,0,4.93,6.34Zm12,.29a1,1,0,0,0,.7-.29l.71-.71a1,1,0,1,0-1.41-1.41L17,5.64a1,1,0,0,0,0,1.41A1,1,0,0,0,17.66,7.34ZM21,11H20a1,1,0,0,0,0,2h1a1,1,0,0,0,0-2Zm-9,8a1,1,0,0,0-1,1v1a1,1,0,0,0,2,0V20A1,1,0,0,0,12,19ZM18.36,17A1,1,0,0,0,17,18.36l.71.71a1,1,0,0,0,1.41,0,1,1,0,0,0,0-1.41ZM12,6.5A5.5,5.5,0,1,0,17.5,12,5.51,5.51,0,0,0,12,6.5Zm0,9A3.5,3.5,0,1,1,15.5,12,3.5,3.5,0,0,1,12,15.5Z"/></svg>
							<!-- moon icon -->
							<svg class="swap-off fill-current w-5 h-5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path d="M21.64,13a1,1,0,0,0-1.05-.14,8.05,8.05,0,0,1-3.37.73A8.15,8.15,0,0,1,9.08,5.49a8.59,8.59,0,0,1,.25-2A1,1,0,0,0,8,2.36,10.14,10.14,0,1,0,21.64,13Zm-9.5,6.69A8.14,8.14,0,0,1,7.08,5.22v.27A10.15,10.15,0,0,0,17.22,15.63a9.79,9.79,0,0,0,2.1-.22A8.11,8.11,0,0,1,12.14,19.73Z"/></svg>
						</label>
						<div class="badge badge-success gap-1" id="connection-status">
							<span class="w-2 h-2 rounded-full bg-success"></span>
							Connected
						</div>
					</div>
				</header>
				<div class="bg-base-200 p-2 sm:p-3 flex flex-wrap gap-2 sm:gap-3 items-center border-b border-base-300">
					<!-- Primary controls - always visible -->
					<div class="flex items-center gap-2">
						<button id="pause-btn" class="btn btn-sm btn-outline" onclick="togglePause()">Pause</button>
						<button id="save-btn" class="btn btn-sm btn-success hidden">Save</button>
					</div>
					
					<!-- Container filter dropdown -->
					<div class="dropdown">
						<label tabindex="0" class="btn btn-sm btn-outline">
							<span class="hidden sm:inline">Containers </span>({ containerCount(containers) })
							<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
							</svg>
						</label>
						<ul tabindex="0" class="dropdown-content z-10 menu p-2 shadow bg-base-200 rounded-box w-72 max-h-96 overflow-y-auto flex-nowrap">
							for _, c := range containers {
								if c.State == "running" {
									<li>
										<label class="flex items-center gap-2 cursor-pointer">
											<input type="checkbox" class="checkbox checkbox-sm container-filter" value={ c.ID } checked/>
											<span class="text-sm truncate">{ c.Name }</span>
										</label>
									</li>
								}
							}
						</ul>
					</div>
					
					<!-- Level filters - horizontal scroll on mobile -->
					<div class="flex gap-1 overflow-x-auto max-w-[200px] sm:max-w-none scrollbar-hide">
						<button class="btn btn-xs level-filter btn-level-alert" data-level="alert">alert</button>
						<button class="btn btn-xs level-filter btn-level-error" data-level="error">error</button>
						<button class="btn btn-xs level-filter btn-level-warning" data-level="warning">warn</button>
						<button class="btn btn-xs level-filter btn-level-info" data-level="info">info</button>
						<button class="btn btn-xs level-filter btn-level-debug" data-level="debug">debug</button>
					</div>
					
					<!-- More menu for secondary actions on mobile -->
					<div class="flex-1"></div>
					<div class="flex items-center gap-2">
						<!-- Snapshots & Export dropdown on mobile, separate buttons on desktop -->
						<div class="hidden sm:flex gap-2">
							<button class="btn btn-sm btn-outline" onclick="openSnapshotsModal()">
								Snapshots
							</button>
							<div class="dropdown">
								<label tabindex="0" class="btn btn-sm btn-outline">Export</label>
								<ul tabindex="0" class="dropdown-content z-10 menu p-2 shadow bg-base-200 rounded-box w-40">
									<li><a onclick="exportLogs('json')">Export JSON</a></li>
									<li><a onclick="exportLogs('csv')">Export CSV</a></li>
									<li><a onclick="exportLogs('markdown')">Export Markdown</a></li>
								</ul>
							</div>
						</div>
						
						<!-- Mobile menu -->
						<div class="dropdown sm:hidden">
							<label tabindex="0" class="btn btn-sm btn-ghost btn-circle">
								<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 5v.01M12 12v.01M12 19v.01M12 6a1 1 0 110-2 1 1 0 010 2zm0 7a1 1 0 110-2 1 1 0 010 2zm0 7a1 1 0 110-2 1 1 0 010 2z"></path>
								</svg>
							</label>
							<ul tabindex="0" class="dropdown-content z-10 menu p-2 shadow bg-base-200 rounded-box w-48 right-0">
								<li><a onclick="openSnapshotsModal()">Snapshots</a></li>
								<li class="menu-title"><span>Export</span></li>
								<li><a onclick="exportLogs('json')">Export JSON</a></li>
								<li><a onclick="exportLogs('csv')">Export CSV</a></li>
								<li><a onclick="exportLogs('markdown')">Export Markdown</a></li>
							</ul>
						</div>
						
						<!-- Search with regex toggle -->
						<div class="flex items-center gap-1">
						<!-- Regex toggle - outside search box -->
						<label class="label cursor-pointer" title="Toggle regex search (checked=regex, unchecked=text)">
							<input type="checkbox" id="regex-toggle" class="toggle toggle-xs toggle-primary" checked/>
						</label>
							
							<div class="relative">
								<input type="text" id="search-input" placeholder="Search logs..." class="input input-sm input-bordered w-40 sm:w-48 pr-8"/>
								<button id="search-clear" class="absolute right-2 top-1/2 transform -translate-y-1/2 text-base-content/30 hover:text-base-content/70 hidden">
									<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor">
										<path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd" />
									</svg>
								</button>
							</div>
						</div>
						
						<!-- Auto-scroll toggle -->
						<label class="hidden sm:flex items-center gap-2 cursor-pointer">
							<input type="checkbox" id="auto-scroll" class="checkbox checkbox-sm" checked/>
							<span class="text-sm whitespace-nowrap">Auto-scroll</span>
						</label>
					</div>
				</div>
				<div id="log-container" class="flex-1 overflow-y-auto p-2 log-container bg-base-300 relative">
					<div id="empty-state" class="hidden absolute inset-0 flex flex-col items-center justify-center text-base-content/40 select-none pointer-events-none whitespace-pre font-mono text-xs sm:text-sm leading-none">
 _                                 
| |    ___   __ _  __ _  __ _ _ __ 
| |   / _ \ / _' |/ _' |/ _' | '__|
| |__| (_) | (_| | (_| | (_| | |   
|_____\___/ \__, |\__, |\__,_|_|   
            |___/ |___/            
						<p class="mt-4 text-base-content/50 text-sm">Waiting for logs...</p>
					</div>
				</div>
				<div class="bg-base-200 px-4 py-2 flex justify-between text-xs text-base-content/60 border-t border-base-300">
					<span id="log-count">0 logs</span>
					<span>Press <kbd class="kbd kbd-xs">?</kbd> { "for" } shortcuts</span>
					<span id="version">Loggarr { version }</span>
				</div>
			</div>
		<!-- Log Details Modal -->
		<dialog id="log-modal" class="modal">
			<div class="modal-box max-w-2xl">
				<h3 class="font-bold text-lg mb-4">Log Details</h3>
				<div class="grid grid-cols-[auto_1fr] gap-x-4 gap-y-2 text-sm">
					<span class="text-base-content/60">Timestamp</span>
					<span id="log-detail-time" class="font-mono"></span>
					<span class="text-base-content/60">Container</span>
					<span id="log-detail-container" class="font-mono"></span>
					<span class="text-base-content/60">Container ID</span>
					<span id="log-detail-container-id" class="font-mono text-xs"></span>
					<span class="text-base-content/60">Stream</span>
					<span id="log-detail-stream" class="font-mono"></span>
					<span class="text-base-content/60">Level</span>
					<span id="log-detail-level" class="font-mono uppercase"></span>
				</div>
				<div class="mt-4">
					<div class="flex items-center justify-between">
						<span class="text-base-content/60 text-sm">Message</span>
						<label class="label cursor-pointer gap-2">
							<span class="label-text text-xs">Highlight search</span>
							<input type="checkbox" id="log-detail-highlight" class="toggle toggle-xs toggle-primary" checked/>
						</label>
					</div>
					<pre id="log-detail-message" class="mt-2 p-3 bg-base-300 rounded-lg text-sm font-mono whitespace-pre-wrap break-words max-h-64 overflow-y-auto"></pre>
				</div>
				<div class="modal-action">
					<button class="btn btn-sm btn-ghost" onclick="copyLogDetails()">Copy</button>
					<button class="btn btn-sm" onclick="document.getElementById('log-modal').close()">Close</button>
				</div>
			</div>
			<form method="dialog" class="modal-backdrop"><button>close</button></form>
		</dialog>
		<!-- Help Modal -->
		<dialog id="help-modal" class="modal">
			<div class="modal-box max-w-md">
				<h3 class="font-bold text-lg mb-4">Keyboard Shortcuts</h3>
				<div class="grid grid-cols-[auto_1fr] gap-x-4 gap-y-2 text-sm">
					<kbd class="kbd kbd-sm">Space</kbd><span>Pause / Resume</span>
					<kbd class="kbd kbd-sm">/</kbd><span>Focus search</span>
					<kbd class="kbd kbd-sm">Cmd+K</kbd><span>Container search</span>
					<kbd class="kbd kbd-sm">Esc</kbd><span>Clear search / Close</span>
					<kbd class="kbd kbd-sm">j</kbd><span>Scroll down</span>
					<kbd class="kbd kbd-sm">k</kbd><span>Scroll up</span>
					<kbd class="kbd kbd-sm">G</kbd><span>Scroll to bottom</span>
					<kbd class="kbd kbd-sm">g g</kbd><span>Scroll to top</span>
					<kbd class="kbd kbd-sm">c</kbd><span>Clear logs</span>
					<kbd class="kbd kbd-sm">Ctrl+S</kbd><span>Save snapshot</span>
					<kbd class="kbd kbd-sm">?</kbd><span>Show this help</span>
				</div>
				<div class="modal-action">
					<button class="btn btn-sm" onclick="document.getElementById('help-modal').close()">Close</button>
				</div>
			</div>
			<form method="dialog" class="modal-backdrop"><button>close</button></form>
		</dialog>
		<!-- Container Search Modal -->
		<dialog id="search-modal" class="modal">
			<div class="modal-box max-w-md">
				<div class="flex items-center gap-2 mb-4">
					<svg class="w-5 h-5 text-base-content/50" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
					</svg>
					<input type="text" id="container-search-input" placeholder="Search containers..." class="input input-sm input-bordered flex-1" autocomplete="off"/>
					<kbd class="kbd kbd-sm">Esc</kbd>
				</div>
				<ul id="container-search-results" class="menu menu-sm bg-base-200 rounded-box max-h-64 overflow-y-auto"></ul>
				<div class="text-xs text-base-content/50 mt-2">
					<kbd class="kbd kbd-xs">Up</kbd> <kbd class="kbd kbd-xs">Down</kbd> to navigate, <kbd class="kbd kbd-xs">Enter</kbd> to toggle, <kbd class="kbd kbd-xs">Esc</kbd> to close
				</div>
			</div>
			<form method="dialog" class="modal-backdrop"><button>close</button></form>
		</dialog>
		<!-- Save Snapshot Modal -->
		<dialog id="save-modal" class="modal">
				<div class="modal-box">
					<h3 class="font-bold text-lg">Save Snapshot</h3>
					<div class="form-control w-full mt-4">
						<label class="label"><span class="label-text">Name</span></label>
						<input type="text" id="snapshot-name" placeholder="My Snapshot" class="input input-bordered w-full"/>
					</div>
					<div class="form-control w-full mt-2">
						<label class="label"><span class="label-text">Description (optional)</span></label>
						<textarea id="snapshot-desc" placeholder="Notes about this snapshot..." class="textarea textarea-bordered w-full"></textarea>
					</div>
					<div class="modal-action">
						<button class="btn btn-ghost" onclick="document.getElementById('save-modal').close()">Cancel</button>
						<button class="btn btn-primary" onclick="confirmSaveSnapshot()">Save</button>
					</div>
				</div>
				<form method="dialog" class="modal-backdrop"><button>close</button></form>
			</dialog>
		<!-- Snapshots List Modal -->
		<dialog id="snapshots-modal" class="modal">
			<div class="modal-box max-w-3xl h-[70vh] flex flex-col p-0 overflow-hidden">
				<div class="p-4 border-b border-base-300 flex justify-between items-center bg-base-200">
					<h3 class="font-bold text-lg">Saved Snapshots</h3>
					<button class="btn btn-sm btn-circle btn-ghost" onclick="document.getElementById('snapshots-modal').close()">✕</button>
				</div>
				<div class="flex-1 overflow-y-auto p-4" id="snapshots-modal-content">
					<div class="text-center text-base-content/50 py-8">Loading...</div>
				</div>
				<div class="p-4 border-t border-base-300 bg-base-200 flex justify-end">
					<button class="btn btn-sm" onclick="document.getElementById('snapshots-modal').close()">Close</button>
				</div>
			</div>
			<form method="dialog" class="modal-backdrop"><button>close</button></form>
		</dialog>
		<!-- Delete Snapshot Modal -->
		<dialog id="delete-modal" class="modal">
			<div class="modal-box">
				<h3 class="font-bold text-lg">Confirm Deletion</h3>
				<p class="py-4">Are you sure you want to delete this snapshot? This action cannot be undone.</p>
				<div class="modal-action">
					<button class="btn btn-ghost" onclick="document.getElementById('delete-modal').close()">Cancel</button>
					<button class="btn btn-error" id="confirm-delete-btn">Delete</button>
				</div>
			</div>
			<form method="dialog" class="modal-backdrop"><button>close</button></form>
		</dialog>
		<!-- Toast Container -->
		<div id="toast-container" class="toast toast-end z-50"></div>
			<script src="/static/app.js"></script>
		</body>
	</html>
}
